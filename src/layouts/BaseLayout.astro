---
import { withBasePath } from "../lib/site-paths";
import { profile } from "../data/profile";
interface Props { title?: string; description?: string; active?: "notes" | "projects" | "about"; }
const { title = `${profile.name} · 技术与日常`, description = profile.summary, active } = Astro.props;
const navigation = [{ id: "notes", label: "文章" }, { id: "projects", label: "项目" }, { id: "about", label: "关于" }];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBasePath("/favicon.svg")} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳至正文</a>
    <header class="site-header container">
      <a class="brand" href={withBasePath("/")}>{profile.name}<span class="accent">.</span></a>
      <nav aria-label="主导航">
        {navigation.map(({ id, label }) => <a href={withBasePath(`/${id}/`)} aria-current={active === id ? "page" : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="main" class="container"><slot /></main>
    <footer class="site-footer container"><span>© {new Date().getFullYear()} {profile.name}</span><span>保持好奇，持续构建。</span></footer>
  </body>
</html>
<style is:global>
  :root {
    color-scheme: light;
    --bg: #fafafa;
    --text: #262626;
    --muted: #666666;
    --border: #e5e5e5;
    --accent: #2563eb;
    --surface-soft: #f0f0f0;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      "Segoe UI",
      "PingFang SC",
      "Microsoft YaHei",
      sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.8;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-width: 320px;
  }
  a {
    color: var(--accent);
    text-decoration: none;
    text-underline-offset: 5px;
  }
  a:hover {
    text-decoration: underline;
  }
  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .container {
    width: min(800px, calc(100% - 48px));
    margin-inline: auto;
  }
  .site-header {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    font-size: 21px;
    font-weight: 750;
    letter-spacing: -0.6px;
    color: var(--text);
  }
  .accent {
    color: var(--accent);
  }
  nav {
    display: flex;
    gap: 28px;
    font-size: 14px;
  }
  nav a {
    color: var(--muted);
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  nav a[aria-current] {
    color: var(--accent);
    text-decoration: underline;
  }
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 24px 30px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted);
    font-size: 12px;
  }
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 8px 16px;
    background: var(--bg);
    transform: translateY(-150%);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  h1,
  h2,
  h3 {
    line-height: 1.45;
    color: var(--text);
  }
  h1 {
    font-size: clamp(28px, 5vw, 36px);
    letter-spacing: -1px;
    margin: 0 0 18px;
    font-weight: 650;
  }
  h2 {
    font-size: 18px;
    margin: 0;
    font-weight: 650;
  }
  h3 {
    font-size: 18px;
    margin: 0 0 7px;
    font-weight: 600;
  }
  p {
    margin: 0 0 18px;
  }
  .eyebrow {
    font:
      12px/1.6 ui-monospace,
      Consolas,
      monospace;
    letter-spacing: 2px;
    color: var(--accent);
    margin: 0 0 14px;
  }
  .page-heading {
    padding: 54px 0 30px;
  }
  .page-heading p:last-child {
    color: var(--muted);
    margin: 0;
    max-width: 620px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 13px;
    border-bottom: 1px solid var(--border);
  }
  .section-heading a {
    font-size: 13px;
    color: var(--muted);
  }
  .page-content {
    padding-bottom: 48px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 12px;
    color: var(--accent);
  }
  @media (max-width: 560px) {
    .site-header {
      min-height: 76px;
      gap: 16px;
    }
    nav {
      gap: 18px;
    }
    .page-heading {
      padding-top: 36px;
    }
    .container {
      width: calc(100% - 40px);
    }
  }
</style>
