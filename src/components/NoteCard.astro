---
interface Props { href: string; title: string; excerpt: string; date: Date; tags: readonly string[]; series?: { name: string; order: number }; }
const { href, title, excerpt, date, tags, series } = Astro.props;
const formattedDate = date.toISOString().slice(0, 10).replaceAll("-", ".");
---
<article class="note-row">
  <time datetime={date.toISOString()}>{formattedDate}</time>
  <div><h3><a href={href}>{title}</a></h3><p>{excerpt}</p><div class="tags">{series && <span>{series.name} · {series.order === 0 ? "总览" : `第 ${series.order} 章`}</span>}{tags.map((tag) => <span>{tag}</span>)}</div></div>
</article>
<style>
  .note-row {
    display: grid;
    grid-template-columns: 105px minmax(0, 1fr);
    gap: 18px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }
  time {
    font:
      12px/1.8 ui-monospace,
      Consolas,
      monospace;
    color: var(--muted);
    padding-top: 5px;
  }
  h3 a {
    color: var(--text);
    overflow-wrap: anywhere;
  }
  h3 a:hover {
    color: var(--accent);
  }
  p {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 9px;
  }
  @media (max-width: 560px) {
    .note-row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 20px 0;
    }
  }
</style>
