---
interface Props {
  project: { title: string; summary: string; stack: readonly string[]; highlights: readonly string[]; githubUrl: string; demoUrl?: string };
  detailed?: boolean;
}
const { project, detailed = false } = Astro.props;
---
<article class="project-row">
  <div class="project-heading"><h3>{project.title}</h3><div class="project-links"><a href={project.githubUrl}>GitHub ↗</a>{project.demoUrl && <a href={project.demoUrl}>Demo ↗</a>}</div></div>
  <p>{project.summary}</p>
  {detailed && <ul>{project.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}
  <div class="stack">{project.stack.join(" / ")}</div>
</article>
<style>
  .project-row {
    padding: 22px 0;
  }
  .project-row + .project-row {
    border-top: 1px solid var(--border);
  }
  .project-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }
  h3 {
    font-family: ui-monospace, Consolas, monospace;
  }
  .project-links {
    display: flex;
    gap: 16px;
    font-size: 13px;
  }
  p,
  ul {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 12px;
  }
  ul {
    padding-left: 20px;
  }
  .stack {
    font:
      12px/1.8 ui-monospace,
      Consolas,
      monospace;
    color: var(--muted);
  }
</style>
