---
import { profile } from "../data/profile";
import { withBasePath } from "../lib/site-paths";
---
<section class="hero">
  <p class="eyebrow">CODE / BUILD / WRITE</p>
  <h1>你好，我是 {profile.name}<span class="accent">.</span></h1>
  <p class="intro">{profile.tagline}<br />在这里分享技术知识与实践经验，记录做过的项目、踩过的坑，以及慢慢想明白的事。</p>
  <div class="links"><a href={profile.links[0].href}>GitHub ↗</a><a href={withBasePath("/about/")}>更多关于我 →</a></div>
</section>
<style>
  .hero {
    padding: 56px 0 42px;
  }
  .intro {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.95;
    margin: 0;
  }
  .links {
    display: flex;
    gap: 24px;
    margin-top: 18px;
    font-size: 13px;
  }
  .links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  @media (max-width: 560px) {
    .hero {
      padding: 38px 0 30px;
    }
  }
</style>
