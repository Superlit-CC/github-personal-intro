---
import { getCollection } from "astro:content";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import NoteCard from "../components/NoteCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import { withBasePath } from "../lib/site-paths";
const notes = (await getCollection("notes")).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf() || (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0)).slice(0,3);
---
<BaseLayout>
  <Hero />
  <section aria-labelledby="latest-writing">
    <div class="section-heading"><h2 id="latest-writing">最新文章</h2><a href={withBasePath("/notes/")}>全部文章 →</a></div>
    {notes.map((note) => <NoteCard href={withBasePath(`/notes/${note.slug}/`)} {...note.data} />)}
  </section>
  <section class="projects" aria-labelledby="selected-projects">
    <div class="section-heading"><h2 id="selected-projects">精选项目</h2><a href={withBasePath("/projects/")}>全部项目 →</a></div>
    {projects.slice(0,2).map((project) => <ProjectCard project={project} />)}
  </section>
</BaseLayout>
<style>
  .projects {
    padding: 36px 0 28px;
  }
</style>
